<UserControl x:Class="SchoolAdmin.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="StatCard" TargetType="md:Card">
            <Setter Property="Width" Value="220" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="UniformCornerRadius" Value="10" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Welcome}" FontSize="18" Margin="0,0,0,20" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,12" />

        <WrapPanel>
            <md:Card Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="AccountSchool" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Students" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StudentCount}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </md:Card>
            <md:Card Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="AccountTie" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Staff" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StaffCount}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </md:Card>
            <md:Card Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="GoogleClassroom" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Classes" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ClassCount}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </md:Card>
            <md:Card Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="AccountKey" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="User logins" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UserCount}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </md:Card>
        </WrapPanel>
    </StackPanel>
</UserControl>
