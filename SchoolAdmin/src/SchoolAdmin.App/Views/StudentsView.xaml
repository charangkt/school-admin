<UserControl x:Class="SchoolAdmin.App.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- List -->
        <md:Card Style="{StaticResource PageCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" VerticalAlignment="Center" />
                            <TextBlock Text="NEW STUDENT" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <ComboBox DockPanel.Dock="Right" Width="180" Margin="0,0,12,0"
                              ItemsSource="{Binding ClassFilters}" SelectedItem="{Binding ClassFilter}"
                              DisplayMemberPath="Label" md:HintAssist.Hint="Class"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             md:HintAssist.Hint="Search name, admission no, phone"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,12,0" />
                </DockPanel>

                <DataGrid ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                          Style="{StaticResource ListGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Adm. No" Binding="{Binding AdmissionNo}" />
                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="Class" Binding="{Binding SchoolClass.DisplayName}" />
                        <DataGridTextColumn Header="Roll" Binding="{Binding RollNo}" />
                        <DataGridTextColumn Header="Guardian" Binding="{Binding GuardianName}" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding GuardianPhone}" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </md:Card>

        <!-- Form (admins only) -->
        <md:Card Grid.Column="1" Width="380" Margin="20,0,0,0" Style="{StaticResource PageCard}"
                 Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource FormTitle}" />
                    <TextBox Text="{Binding AdmissionNo}" md:HintAssist.Hint="Admission no *" Style="{StaticResource FormTextBox}" />
                    <TextBox Text="{Binding FirstName}" md:HintAssist.Hint="First name *" Style="{StaticResource FormTextBox}" />
                    <TextBox Text="{Binding LastName}" md:HintAssist.Hint="Last name" Style="{StaticResource FormTextBox}" />
                    <ComboBox ItemsSource="{Binding Classes}" SelectedValue="{Binding FormClassId}"
                              SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                              md:HintAssist.Hint="Class *" Style="{StaticResource FormComboBox}" />
                    <TextBox Text="{Binding RollNo}" md:HintAssist.Hint="Roll no" Style="{StaticResource FormTextBox}" />
                    <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}"
                              md:HintAssist.Hint="Gender" Style="{StaticResource FormComboBox}" />
                    <DatePicker SelectedDate="{Binding DateOfBirth}" md:HintAssist.Hint="Date of birth" Style="{StaticResource FormDatePicker}" />
                    <TextBox Text="{Binding GuardianName}" md:HintAssist.Hint="Guardian name" Style="{StaticResource FormTextBox}" />
                    <TextBox Text="{Binding GuardianPhone}" md:HintAssist.Hint="Guardian phone" Style="{StaticResource FormTextBox}" />
                    <TextBox Text="{Binding Address}" md:HintAssist.Hint="Address" Style="{StaticResource FormTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                    <DatePicker SelectedDate="{Binding AdmissionDate}" md:HintAssist.Hint="Admission date" Style="{StaticResource FormDatePicker}" />
                    <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="SAVE" Command="{Binding SaveCommand}" Width="120" />
                        <Button Content="DELETE" Command="{Binding DeleteCommand}" Margin="12,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{StaticResource ErrorBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding InfoText}" Style="{StaticResource InfoMessage}" />
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorMessage}" />
                </StackPanel>
            </ScrollViewer>
        </md:Card>

        <!-- Read-only users still need to see errors -->
        <TextBlock Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="20" Text="{Binding ErrorText}"
                   Style="{StaticResource ErrorMessage}"
                   Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
