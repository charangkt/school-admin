<Window x:Class="SchoolAdmin.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SchoolAdmin.App.ViewModels"
        xmlns:views="clr-namespace:SchoolAdmin.App.Views"
        Title="School Admin"
        Width="1200" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <!-- Which view to show for each page view model -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentsViewModel}">
            <views:StudentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffViewModel}">
            <views:StaffView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClassesViewModel}">
            <views:ClassesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MyProfileViewModel}">
            <views:MyProfileView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left menu -->
        <DockPanel Background="{StaticResource NavBackgroundBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,24,20,24">
                <md:PackIcon Kind="School" Width="30" Height="30" Foreground="#FFC107" />
                <TextBlock Text="School Admin" FontSize="20" FontWeight="SemiBold"
                           Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Button DockPanel.Dock="Bottom" Command="{Binding LogoutCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="{StaticResource NavForegroundBrush}"
                    HorizontalContentAlignment="Left" Margin="8,8,8,16" Height="44">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Logout" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock Text="Log out" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}"
                     Foreground="{StaticResource NavForegroundBrush}" Margin="8,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,10">
                            <md:PackIcon Kind="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Top bar + page content -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" Padding="28,16"
                    BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="AccountCircle" Width="24" Height="24"
                                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UserDisplay}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                        <Button Click="OnChangePasswordClick" ToolTip="Change password" Margin="12,0,0,0"
                                Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36">
                            <md:PackIcon Kind="KeyVariant" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedNavItem.Title}" FontSize="22" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Margin="28" />
        </DockPanel>
    </Grid>
</Window>
