<UserControl x:Class="SchoolAdmin.App.Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <md:Card Style="{StaticResource PageCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Command="{Binding NewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" VerticalAlignment="Center" />
                            <TextBlock Text="NEW STAFF" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             md:HintAssist.Hint="Search name, code, designation, phone"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,12,0" />
                </DockPanel>

                <DataGrid ItemsSource="{Binding StaffMembers}" SelectedItem="{Binding SelectedStaff}"
                          Style="{StaticResource ListGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding EmployeeCode}" />
                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" />
                        <DataGridTextColumn Header="Joined" Binding="{Binding JoiningDate, StringFormat=dd-MM-yyyy}" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </md:Card>

        <md:Card Grid.Column="1" Margin="20,0,0,0" Style="{StaticResource PageCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource FormTitle}" />
                    <TextBox Text="{Binding EmployeeCode}" md:HintAssist.Hint="Employee code *" Style="{StaticResource FormTextBox}" />
                    <TextBox Text="{Binding FullName}" md:HintAssist.Hint="Full name *" Style="{StaticResource FormTextBox}" />
                    <TextBox Text="{Binding Designation}" md:HintAssist.Hint="Designation (e.g. Teacher, Clerk)" Style="{StaticResource FormTextBox}" />
                    <TextBox Text="{Binding Phone}" md:HintAssist.Hint="Phone" Style="{StaticResource FormTextBox}" />
                    <TextBox Text="{Binding Email}" md:HintAssist.Hint="Email" Style="{StaticResource FormTextBox}" />
                    <DatePicker SelectedDate="{Binding JoiningDate}" md:HintAssist.Hint="Joining date" Style="{StaticResource FormDatePicker}" />
                    <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="SAVE" Command="{Binding SaveCommand}" Width="120" />
                        <Button Content="DELETE" Command="{Binding DeleteCommand}" Margin="12,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{StaticResource ErrorBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding InfoText}" Style="{StaticResource InfoMessage}" />
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorMessage}" />
                </StackPanel>
            </ScrollViewer>
        </md:Card>
    </Grid>
</UserControl>
