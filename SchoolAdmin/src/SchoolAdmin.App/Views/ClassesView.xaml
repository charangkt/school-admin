<UserControl x:Class="SchoolAdmin.App.Views.ClassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding InfoText}" Style="{StaticResource InfoMessage}" />
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorMessage}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Classes -->
            <md:Card Style="{StaticResource PageCard}" Margin="0,0,10,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="ADD LKG – CLASS 12"
                                Command="{Binding AddStandardClassesCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <TextBlock Text="Classes" Style="{StaticResource FormTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <UniformGrid Columns="3">
                            <TextBox Text="{Binding ClassName}" md:HintAssist.Hint="Class name *" Style="{StaticResource FormTextBox}" Margin="0,0,8,12" />
                            <TextBox Text="{Binding ClassSection}" md:HintAssist.Hint="Section *" Style="{StaticResource FormTextBox}" Margin="0,0,8,12" />
                            <TextBox Text="{Binding ClassOrder}" md:HintAssist.Hint="Order" Style="{StaticResource FormTextBox}" />
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="SAVE CLASS" Command="{Binding SaveClassCommand}" />
                            <Button Content="NEW" Command="{Binding NewClassCommand}" Margin="12,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Content="DELETE" Command="{Binding DeleteClassCommand}" Margin="12,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{StaticResource ErrorBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" Style="{StaticResource ListGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding DisplayOrder}" />
                            <DataGridTextColumn Header="Class" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Section" Binding="{Binding Section}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </md:Card>

            <!-- Subjects -->
            <md:Card Grid.Column="1" Style="{StaticResource PageCard}" Margin="10,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Subjects" Style="{StaticResource FormTitle}" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <UniformGrid Columns="3">
                            <TextBox Text="{Binding SubjectName}" md:HintAssist.Hint="Subject name *" Style="{StaticResource FormTextBox}" Margin="0,0,8,12" />
                            <TextBox Text="{Binding SubjectCode}" md:HintAssist.Hint="Code" Style="{StaticResource FormTextBox}" Margin="0,0,8,12" />
                            <TextBox Text="{Binding SubjectOrder}" md:HintAssist.Hint="Order" Style="{StaticResource FormTextBox}" />
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="SAVE SUBJECT" Command="{Binding SaveSubjectCommand}" />
                            <Button Content="NEW" Command="{Binding NewSubjectCommand}" Margin="12,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Content="DELETE" Command="{Binding DeleteSubjectCommand}" Margin="12,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{StaticResource ErrorBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" Style="{StaticResource ListGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding DisplayOrder}" />
                            <DataGridTextColumn Header="Subject" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </md:Card>
        </Grid>
    </DockPanel>
</UserControl>
