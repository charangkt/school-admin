@page "/change-password"
@attribute [Authorize]
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>Change password · School Admin</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Change password</MudText>

<MudPaper Class="pa-5" Elevation="1" Style="max-width:420px">
    <MudStack Spacing="3">
        <MudTextField @bind-Value="_current" Label="Current password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_new" Label="New password (min 6 characters)" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_confirm" Label="Confirm new password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Change">Change password</MudButton>
    </MudStack>
</MudPaper>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string _current = "";
    private string _new = "";
    private string _confirm = "";

    private async Task Change()
    {
        if (_new.Length < 6)
        {
            Snackbar.Add("New password must be at least 6 characters.", Severity.Warning);
            return;
        }

        if (_new != _confirm)
        {
            Snackbar.Add("The new passwords do not match.", Severity.Warning);
            return;
        }

        var userId = (await AuthState).User.UserId();
        if (!await Auth.ChangePasswordAsync(userId, _current, _new))
        {
            Snackbar.Add("Current password is incorrect.", Severity.Error);
            return;
        }

        _current = _new = _confirm = "";
        Snackbar.Add("Your password has been changed.", Severity.Success);
    }
}
