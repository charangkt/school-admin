@page "/access-denied"
@attribute [Authorize]

<PageTitle>Access denied · School Admin</PageTitle>

<MudPaper Class="pa-8" Elevation="1">
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Style="font-size:4rem" />
        <MudText Typo="Typo.h6">You do not have access to this page</MudText>
        <MudText Color="Color.Secondary">Your role does not include this part of the system.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="mt-2">Go to home</MudButton>
    </MudStack>
</MudPaper>
