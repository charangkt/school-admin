@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject IConfiguration Configuration

<PageTitle>Sign in · School Admin</PageTitle>

<div class="login-page">
    <form method="post" action="account/login" class="login-card">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

        <div class="login-logo">🎓</div>
        <h1>School Admin</h1>
        <p class="login-subtitle">Sign in to continue</p>

        <label for="username">Username</label>
        <input id="username" name="username" autocomplete="username" required autofocus />

        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />

        @if (Error is not null)
        {
            <div class="login-error">Invalid username or password.</div>
        }

        <button type="submit">SIGN IN</button>

        @if (Configuration.GetValue<bool>("DemoMode"))
        {
            <div class="demo-box">
                <strong>Demo logins</strong> — click one to fill it in
                <table>
                    @foreach (var (username, password, role) in DemoDataSeeder.DemoLogins)
                    {
                        <tr class="demo-row" data-user="@username" data-pass="@password">
                            <td>@role.Label()</td>
                            <td><code>@username</code></td>
                            <td><code>@password</code></td>
                        </tr>
                    }
                </table>
            </div>
            <script suppress-error="BL9992">
                document.querySelectorAll('.demo-row').forEach(function (row) {
                    row.addEventListener('click', function () {
                        document.getElementById('username').value = row.dataset.user;
                        document.getElementById('password').value = row.dataset.pass;
                    });
                });
            </script>
        }
    </form>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }
}
